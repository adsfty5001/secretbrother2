# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only (NEVER expose to client). Used in /api/* routes.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# PortOne(아임포트) V1 (관리자콘솔에서 확인)
NEXT_PUBLIC_PORTONE_IMP_CODE=imp07764510
PORTONE_API_KEY=your_portone_rest_api_key
PORTONE_API_SECRET=your_portone_rest_api_secret

# Site URL (for redirects)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
